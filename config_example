server {
    listen 127.0.0.1:8083;
    client_max_body_size 100;

    # 1. / must answer to GET request ONLY
    # 2. Any .bla file must answer to POST by calling cgi_test
    location / {
        allow_methods GET;
        root /home/zabu-bak/webserv;
        cgi_pass .bla /home/zabu-bak/webserv/cgi_tester;
        autoindex on;
    }

    location /post_body {
        allow_methods POST;
        upload_store /uploads;
    }

    # 4. /directory/ must answer GET, use YoupiBanane root, and default to youpi.bad_extension
    location /directory {
        allow_methods GET POST;
        root /home/zabu-bak/webserv/YoupiBanane;
        index youpi.bad_extension;
    }
}
